GROQ_API_KEY=your_groq_api_key
TAVILY_API_KEY=your_tavily_api_key

# Google OAuth (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Groq retires models; this one must support tool calling.
GROQ_MODEL=openai/gpt-oss-120b

# Reply tracking with Resend Inbound (free plan, no card needed).
# Approved emails go out from the user's Gmail (send-only) with
# Reply-To: inv-<token>@RESEND_INBOUND_DOMAIN. Point a Resend "email.received"
# webhook at https://<your-app>/api/email/inbound.
RESEND_API_KEY=re_your_resend_api_key
# Dashboard > Emails > Receiving > Receiving address, e.g. abc123.resend.app
RESEND_INBOUND_DOMAIN=
# The webhook's signing secret (starts with whsec_)
RESEND_WEBHOOK_SECRET=

# CORS — comma-separated origins that may send credentials. Required for the
# guest_session cookie when frontend and backend live on different origins.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase (Project Settings > API — use the service_role key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_INVOICE_FILE_BUCKET=invoice-files

# Security
SECRET_KEY=generate-a-random-32-byte-key-here

# Agent conversation store (LangGraph checkpoints). Empty = in-memory, lost on restart.
# Use Supabase's TRANSACTION pooler (port 6543; Vercel can't reach the IPv6-only direct host).
# Prepared statements are turned off in code (src/checkpointer.py), as the pooler requires.
# Log in as the dedicated langgraph_checkpointer role (supabase/schema.sql), NOT `postgres`:
# it can only touch its own tables, and tables `postgres` creates are readable by the anon key.
# Format: postgresql://langgraph_checkpointer.PROJECTREF:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres
# Create the tables once (and after upgrading langgraph-checkpoint-postgres):
#   python -m src.checkpoint_setup
# Leave this empty for local dev and tests unless you mean to write to that database.
DATABASE_URL=

# --- Optional: LangSmith tracing (https://smith.langchain.com) ---
# LangChain sends every agent run to LangSmith when this is on. Each trace is
# labelled with our X-Trace-Id (metadata trace_run_id), invoice, kind and level.
# Agent-based workspaces: set LANGSMITH_AGENT_ID + LANGSMITH_AGENT_ENVIRONMENT
# (local / production). Project-based: set LANGSMITH_PROJECT instead. Never
# both. /api/health -> "langsmith" shows where runs go, or what is wrong.
# Prompts include client names, amounts and replies: LANGSMITH_HIDE_INPUTS=true
# and LANGSMITH_HIDE_OUTPUTS=true keep them out of LangSmith if needed.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=invoice-chaser
LANGSMITH_AGENT_ENVIRONMENT=local

# --- Optional: Sentry error monitoring ---
# Backend DSN: referfee/invoice-dispute-agent-server. Empty disables monitoring.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Optional outside Vercel; Vercel uses VERCEL_GIT_COMMIT_SHA automatically.
SENTRY_RELEASE=

# Put browser variables in frontend/.env for local Vite development.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
# Build-only source map upload; never prefix the token with VITE_.
SENTRY_ORG=referfee
SENTRY_PROJECT=invoice-dispute-agent-frontend
SENTRY_AUTH_TOKEN=

# Optional free app-to-Slack alerts with links to Sentry events.
# Keep this incoming webhook server-side (Vercel Secret); never use VITE_ for it.
SLACK_WEBHOOK_URL=
# Enable in frontend/.env or Vercel only once the server webhook is configured.
VITE_SLACK_ERROR_ALERTS=false
